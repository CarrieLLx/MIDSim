/scripts/_check_x*.ps1

# Publication scope: retain local material but publish only these roots.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/setup.py
!/src/
!/config/
!/datasets/
!/docs/
!/scripts/

/src/*
!/src/app.py
!/src/main.py
!/src/envs/
!/src/onesim/

# Exactly seven runtime configuration files.
/config/*
!/config/config_facebook.json
!/config/config_instagram.json
!/config/config_x.json
!/config/model_config.json
!/config/params_facebook.json
!/config/params_instagram.json
!/config/params_x.json

# Only the standalone release checker is needed; entry points are in src.
/scripts/*
!/scripts/check_release.py

/docs/*
!/docs/bm25_search.md
!/docs/comment_views.md
!/docs/model_request_retries.md

/datasets/*
!/datasets/facebook/
!/datasets/ins/
!/datasets/x/
/datasets/facebook/*
/datasets/ins/*
!/datasets/facebook/posts.csv
!/datasets/facebook/comments.csv
!/datasets/facebook/profiles.csv
!/datasets/facebook/relationships.csv
!/datasets/facebook/historical_posts.csv
!/datasets/facebook/historical_post_comments.csv
!/datasets/ins/posts.csv
!/datasets/ins/comments.csv
!/datasets/ins/profiles.csv
!/datasets/ins/relationships.csv
!/datasets/ins/historical_posts.csv
!/datasets/ins/historical_post_comments.csv
/datasets/x/*
!/datasets/x/README.md
!/datasets/x/posts.jsonl
!/datasets/x/comments.jsonl
!/datasets/x/user_profiles.jsonl
!/datasets/x/relationships.csv
!/datasets/x/historical_posts.jsonl
!/datasets/x/historical_comments.jsonl
!/datasets/facebook/embeddings/
!/datasets/ins/embeddings/
!/datasets/x/embeddings/
/datasets/*/embeddings/*
!/datasets/facebook/embeddings/bge-base-en-v1.5_embeddings.json
!/datasets/ins/embeddings/bge-base-en-v1.5_embeddings.json
!/datasets/ins/embeddings/rent_bge-base-en-v1.5_embeddings.json
!/datasets/x/embeddings/bge-base-en-v1.5_embeddings.json

