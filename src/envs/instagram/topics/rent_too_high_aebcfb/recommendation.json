{
  "fine_interest_recommendation_content_pool": {
    "ig_rent_01": {
      "post_id": "ig_rent_01",
      "desc": "We cannot talk about affordable rent without talking about building more homes."
    },
    "ig_rent_02": {
      "post_id": "ig_rent_02",
      "desc": "Housing supply is not the whole story, but shortages make every rent increase hurt more. What would a workable policy look like?"
    },
    "ig_rent_03": {
      "post_id": "ig_rent_03",
      "desc": "Why are apartments so hard to build near jobs and public transit?"
    },
    "ig_rent_04": {
      "post_id": "ig_rent_04",
      "desc": "Should cities allow more duplexes and small apartment buildings in single-family neighborhoods? Curious how others see this."
    },
    "ig_rent_05": {
      "post_id": "ig_rent_05",
      "desc": "Affordable housing should mean more than a lottery with a ten-year waitlist."
    },
    "ig_rent_06": {
      "post_id": "ig_rent_06",
      "desc": "More housing near train and bus lines would help both renters and commuters."
    },
    "ig_rent_07": {
      "post_id": "ig_rent_07",
      "desc": "Zoning reform is not glamorous, but it could change what families pay in rent."
    },
    "ig_rent_08": {
      "post_id": "ig_rent_08",
      "desc": "How do we build more homes without displacing the people already living there?"
    },
    "ig_rent_09": {
      "post_id": "ig_rent_09",
      "desc": "Public investment in affordable housing needs to be matched with local permitting reform."
    },
    "ig_rent_10": {
      "post_id": "ig_rent_10",
      "desc": "A city that adds jobs but blocks new housing is creating its own rent problem. Thoughts?"
    },
    "ig_rent_11": {
      "post_id": "ig_rent_11",
      "desc": "Would faster approvals for apartment construction lower rents over time?"
    },
    "ig_rent_12": {
      "post_id": "ig_rent_12",
      "desc": "Teachers and service workers should be able to live near the communities they serve."
    },
    "ig_rent_13": {
      "post_id": "ig_rent_13",
      "desc": "We need affordable options for seniors, young adults, and families—not just luxury towers."
    },
    "ig_rent_14": {
      "post_id": "ig_rent_14",
      "desc": "The housing crisis looks different in rural areas, suburbs, and major cities. Anyone seen this handled well locally?"
    },
    "ig_rent_15": {
      "post_id": "ig_rent_15",
      "desc": "Can vacant office buildings realistically be converted into affordable apartments?"
    },
    "ig_rent_16": {
      "post_id": "ig_rent_16",
      "desc": "Building more is important, but tenant protections matter during the transition."
    },
    "ig_rent_17": {
      "post_id": "ig_rent_17",
      "desc": "The rent debate should include land costs, infrastructure, and construction labor."
    },
    "ig_rent_18": {
      "post_id": "ig_rent_18",
      "desc": "What is your city doing to make starter homes and modest rentals possible?"
    },
    "ig_rent_19": {
      "post_id": "ig_rent_19",
      "desc": "Affordable housing plans fail if residents have no access to work, schools, or transit."
    },
    "ig_rent_20": {
      "post_id": "ig_rent_20",
      "desc": "If everyone agrees rent is too high, what housing trade-offs are we willing to make?"
    }
  },
